{
  "name": "@atbash/codex-plugin",
  "version": "0.3.3",
  "license": "Apache-2.0",
  "private": true,
  "description": "Atbash safety enforcement for Codex.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./runtime/index.cjs",
  "files": [
    ".codex-plugin",
    "assets",
    "hooks",
    "runtime",
    "skills"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "build:marketplace": "node build-marketplace.mjs",
    "build:marketplace:dev": "node build-marketplace.mjs --env dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-tests/tests/*.test.js",
    "status": "node dist/status.cjs",
    "hook:install": "node dist/install-hook.cjs"
  },
  "dependencies": {
    "@atbash/sdk": "0.9.2"
  },
  "devDependencies": {
    "@atbash/sdk-dev": "npm:@atbash/sdk@0.16.4-dev.0"
  }
}
