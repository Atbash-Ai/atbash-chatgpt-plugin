{
  "name": "@atbash/codex-plugin",
  "version": "0.3.3",
  "private": true,
  "description": "Atbash safety enforcement for Codex.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./runtime/index.cjs",
  "files": [
    ".codex-plugin",
    "assets",
    "hooks",
    "runtime",
    "skills"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "build:marketplace": "node build-marketplace.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-concurrency=2 dist-tests/tests/*.test.js",
    "status": "node dist/status.cjs",
    "hook:install": "node dist/install-hook.cjs"
  },
  "dependencies": {
    "@atbash/sdk": "0.7.1",
    "postchain-client": "2.1.2",
    "proper-lockfile": "4.1.2"
  }
}
